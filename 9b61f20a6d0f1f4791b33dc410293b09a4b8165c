      },
      "writtenOn": "2026-04-08T10:01:25Z",
      "side": 1,
      "message": "Apparently the format is required by some DC tools I was not aware about. Nevermind then.",
      "parentUuid": "c08d2a38_2a9947e0",
      "revId": "9b61f20a6d0f1f4791b33dc410293b09a4b8165c",
